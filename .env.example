# Demo values for local Docker only. NOT real secrets.
# For any real deployment, generate a new SECRET_KEY and a strong DB password.
SECRET_KEY=your_secret-key_here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=warkop_saas
DB_USER=warkop
DB_PASSWORD=warkop_demo_password


# Used when running without Docker. docker-compose overrides this with "db".
DB_HOST=localhost
DB_PORT=5432
