meta {
  name: 1. Login (owner, Warkop Senja)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/tenants/login/
  body: json
  auth: none
}

body:json {
  {
    "email": "{{ownerEmail}}",
    "password": "{{demoPassword}}"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("accessToken", res.body.access);
}

tests {
  test("login returns an access token", function () {
    expect(res.body.access).to.be.a("string");
  });
}
