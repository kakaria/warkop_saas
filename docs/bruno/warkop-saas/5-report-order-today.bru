meta {
  name: 5. Report: orders today
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/reports/orders/today/
  body: none
  auth: bearer
}

headers {
  X-Tenant-Id: {{tenantIdSenja}}
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
}

tests {
  test("has a numeric count", function () {
    expect(res.body.count).to.be.a("number");
  });
}
